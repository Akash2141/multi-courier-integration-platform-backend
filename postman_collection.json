            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"ORD-UNKNOWN-TEST\",\n  \"courier_partner\": \"non_existent_courier\",\n  \"sender\": {\n    \"name\": \"Test Shipper\",\n    \"phone\": \"9876543210\",\n    \"address\": \"Address\",\n    \"city\": \"City\",\n    \"state\": \"State\",\n    \"pincode\": \"110001\"\n  },\n  \"recipient\": {\n    \"name\": \"Test Recipient\",\n    \"phone\": \"9876543211\",\n    \"address\": \"Address\",\n    \"city\": \"City\",\n    \"state\": \"State\",\n    \"pincode\": \"400001\"\n  },\n  \"package_details\": {\n    \"weight_kg\": 1,\n    \"length_cm\": 10,\n    \"breadth_cm\": 10,\n    \"height_cm\": 10,\n    \"items_count\": 1,\n    \"item_description\": \"Item\"\n  },\n  \"payment_details\": {\n    \"payment_mode\": \"PREPAID\",\n    \"collectable_amount\": 0,\n    \"declared_value\": 100\n  }\n}"
